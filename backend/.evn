# Server
PORT=5000

# Firebase Admin SDK (Update these after downloading service account)
FIREBASE_PROJECT_ID=smartblood-ai
FIREBASE_CLIENT_EMAIL=your-service-account-email@smartblood-ai.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Gemini AI (optional)
GEMINI_API_KEY=your_gemini_key_here

# Environment
NODE_ENV=development